# PostgreSQL connection string (used by Drizzle ORM)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/mittensdb

# Port for the NestJS HTTP server (defaults to 3000 if not set)
PORT=3000

# Twitch OAuth credentials for the chatbot
# Register an app at https://dev.twitch.tv/console/apps to get these
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
